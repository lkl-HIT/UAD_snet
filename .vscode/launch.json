{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python SimpleNet_RealIAD",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py", // 指定主程序路径
            "console": "integratedTerminal",
            "args": [
                "--gpu", "0",
                "--seed", "0",
                "--log_group", "simplenet_realiad_debug",
                "--log_project", "RealIAD_Results",
                "--results_path", "results",
                "--run_name", "run",
                "net",
                "-b", "wideresnet50",
                "-le", "layer2",
                "-le", "layer3",
                "--pretrain_embed_dimension", "1536",
                "--target_embed_dimension", "1536",
                "--patchsize", "3",
                "--meta_epochs", "40",
                "--embedding_size", "256",
                "--gan_epochs", "4",
                "--noise_std", "0.015",
                "--dsc_hidden", "1024",
                "--dsc_layers", "2",
                "--dsc_margin", "0.5",
                "--pre_proj", "1",
                "dataset",
                "--batch_size", "2",
                "--resize", "329",
                "--imagesize", "288",
                "-d", "audiojack",
                "-d", "bottle_cap",
                "-d", "button_battery",
                "-d", "end_cap",
                "-d", "eraser",
                "-d", "fire_hood",
                "-d", "mint",
                "-d", "mounts",
                "-d", "pcb",
                "-d", "phone_battery",
                "-d", "plastic_nut",
                "-d", "plastic_plug",
                "-d", "porcelain_doll",
                "-d", "regulator",
                "-d", "rolled_strip_base",
                "-d", "sim_card_set",
                "-d", "switch",
                "-d", "tape",
                "-d", "terminalblock",
                "-d", "toothbrush",
                "-d", "toy",
                "-d", "toy_brick",
                "-d", "transistor1",
                "-d", "usb",
                "-d", "usb_adaptor",
                "-d", "u_block",
                "-d", "vcpill",
                "-d", "wooden_beads",
                "-d", "woodstick",
                "-d", "zipper",
                "realiad_1",
                "/home/lkl/dataset/Real-IAD"
            ]
        }
    ]
}